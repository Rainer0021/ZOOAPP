<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zoo_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciando Bluetooth..."
            android:textColor="@color/zoo_green_dark"
            android:textStyle="bold"
            android:padding="4dp" />

        <!-- Tarjeta de Selección de Animal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐾 Selección de Especie"
                android:textColor="@color/zoo_green_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spAnimals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvAnimalRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#555555" />
        </LinearLayout>

        <!-- Tarjeta de Lecturas y Alertas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mediciones del Hábitat"
                android:textColor="@color/zoo_green_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvSimTemp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Temp: -- °C"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSimHum"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Humedad: -- %"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSimCo2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CO2: -- ppm"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAlertStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_alert_ok"
                android:padding="12dp"
                android:text="Evaluando parámetros..."
                android:textColor="@color/alert_ok_text"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnSimulateNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simular Lectura de Sensores"
                android:backgroundTint="@color/zoo_green_primary"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Registros SQLite -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📂 Historial Local SQLite"
            android:textStyle="bold"
            android:textColor="@color/zoo_green_dark"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvDbRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>